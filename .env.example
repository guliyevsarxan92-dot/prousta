SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Boş qalsa settings.py-dakı Supabase bazası işlənir (canlı data!)
DATABASE_URL=

# Cloudinary (production-da şəkil saxlamaq üçün)
