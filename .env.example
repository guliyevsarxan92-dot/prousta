# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=prousta.az,www.prousta.az,localhost,127.0.0.1
# Required. Use a separate local database for development; never copy production credentials.
DATABASE_URL=sqlite:///db.sqlite3
CLOUDINARY_URL=
PRIVATE_MEDIA_ROOT=./private_media
# Only actual reverse-proxy networks may provide forwarded protocol/client IP.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=
GOOGLE_WEB_CLIENT_ID=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@prousta.az
API_TOKEN_MAX_AGE=2592000
